{
  "name": "@nexo/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXO CLI `nexo`: mesmo Control Plane via HTTP client (fetch nativo) — SPEC.md §10",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "bin": {
    "nexo": "./dist/main.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx --conditions=development src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start:dist": "node dist/main.js"
  }
}
