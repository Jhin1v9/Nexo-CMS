{
  "name": "@nexo/git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXO Git: GitClient/GitService sobre git CLI real via @nexo/runtime CommandExecutor (doc 10, D2)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
