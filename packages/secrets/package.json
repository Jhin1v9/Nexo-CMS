{
  "name": "@nexo/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXO Secret Store local (M4 — M4-CONTRACTS §2.1/§9, D25): AES-256-GCM, chave mestra em NEXO_HOME/keys (0600), redaction e injeção em memória",
