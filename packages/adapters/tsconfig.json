{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    // dep: build tsc -p resolve @nexo/shared pelas declaracoes de dist (shared builda antes via pnpm -r topologico);
    // em dev/test (tsx/vitest) a resolucao usa exports -> src sem build.
    "paths": {
      "@nexo/shared": ["../shared/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
